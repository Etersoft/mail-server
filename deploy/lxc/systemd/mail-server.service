[Unit]
Description=mail-server: bulk mailing API
Documentation=https://github.com/Eterpost/eterpost-server
After=network-online.target redis.service
Wants=network-online.target
Requires=redis.service

[Service]
Type=simple
User=mailing
Group=mailing
WorkingDirectory=/opt/eterfund-mail/mail-server
# SMTP_PASSWORD и другие переменные для %{...} в конфиге
EnvironmentFile=-/etc/eterfund-mail/mail-server.env
ExecStart=/usr/bin/node server/dist/src/index.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
