[Unit]
Description=subscription-facade: subscribe/unsubscribe pages for mail-server
Documentation=https://github.com/Etersoft/subscription-facade
After=network-online.target mail-server.service
Wants=network-online.target

[Service]
Type=simple
User=mailing
Group=mailing
WorkingDirectory=/opt/eterfund-mail/subscription-facade
ExecStart=/usr/bin/node dist/src/index.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
