{
  // См. README mail-sorter. Пароли IMAP и SMTP и ключ API mail-server —
  // в /etc/eterfund-mail/mail-sorter.env
  "database": {
    "type": "mail-server",
    "options": { "backend": "http://127.0.0.1:8000", "apiKey": "%{MAIL_SERVER_API_KEY}" }
  },
  "forwardTo": "support@example.com",
  "imapConnection": {
    "host": "imap.example.com",
    "port": 993,
    "tls": true,
    "user": "noreply@example.com",
    "password": "%{IMAP_PASSWORD}"
  },
  "logging": { "maxLogLevel": "info" },
  // Тот же почтовый сервер, что у mail-server; пароль — SMTP_PASSWORD
  "mailer": {
    "from": "noreply@example.com",
    "host": "mail.example.com",
    "port": 587,
    "auth": { "user": "noreply@example.com", "pass": "%{SMTP_PASSWORD}" },
    "name": "mailing.example.com"
  },
  // Начать с true (ничего не меняется), проверить журнал, затем false
  "readonly": true,
  "redis": { "host": "127.0.0.1", "port": 6379, "db": 0 }
}
