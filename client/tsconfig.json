{
  "compilerOptions": {
    "jsx": "react",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "noUncheckedSideEffectImports": false,
    "outDir": "dist",
    "rootDir": "..",
    "removeComments": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "target": "es2020"
  },
  "include": [
    "src/**/*"
  ]
}
