{
  "name": "mail-server",
  "version": "0.1.0",
  "description": "Bulk mailing service",
  "main": "server/dist/src/index.js",
  "scripts": {
    "build": "npm run server:build && npm run client:build",
    "client:build": "webpack --mode production --config client/webpack.config.js",
    "client:watch": "webpack serve --mode development --config client/webpack.config.js",
    "lint": "eslint server client",
    "lint-fix": "eslint --fix server client",
    "server:build": "tsc -p server",
    "server:start": "node server/dist/src/index.js",
    "server:watch": "tsc -w -p server",
    "server:watch-run": "node --watch-path=server/dist server/dist/src/index.js",
    "test": "tsc -p server && node --test --test-concurrency=1 'server/dist/tests/**/*.test.js'",
    "typecheck": "tsc -p server --noEmit && tsc -p client --noEmit"
  },
  "author": "",
  "private": true,
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cors": "^2.8.6",
    "cron-converter": "^2.1.0",
    "csv-stringify": "^6.9.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.10",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.1.0",
    "redis": "^6.3.0",
    "validator": "^13.15.35",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-transition-group": "^4.4.12",
    "@types/validator": "^13.15.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "html-webpack-plugin": "^5.6.8",
    "lodash-es": "^4.18.1",
    "mini-css-extract-plugin": "^2.10.2",
    "papaparse": "^5.7.0",
    "pell": "^1.0.6",
    "pretty": "^2.0.0",
    "query-string": "^9.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-tabs": "^6.1.1",
    "react-transition-group": "^4.4.5",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.105.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
